# Gerenciador Pos-Venda - variaveis de ambiente de HOMOLOGACAO (FEAT-012).
# Nunca versionar um .env.hml com valores reais (CLAUDE.md Sec. 6).
# Copiar para ".env.hml" no servidor de homologacao e preencher os TODO.

SECRET_KEY=TODO-gerar-chave-secreta-unica-so-para-homologacao
# Homologacao/producao nunca com DEBUG=True (CLAUDE.md Sec. 6 e regra do
# DevOps) - relatorio de erro nunca deve expor stack trace ao usuario.
DEBUG=False
# Servidor de homologacao conhecido (ver docs_gerenciador_pos_venda/devops/
# DEPLOYMENT.md) - trocar/completar se o dominio mudar.
ALLOWED_HOSTS=192.168.90.109
# Porta publicada pelo Nginx no host (docker-compose.hml.yml, servico
# "nginx") - troque se 8010 ja estiver em uso no servidor.
HML_HTTP_PORT=8010

# Banco de dados: MySQL 8.0 em todos os ambientes (architecture.md, "Banco
# de Dados").
DB_NAME=gerenciador_posvenda_hml
DB_USER=posvenda_app
DB_PASSWORD=TODO-senha-forte-so-de-homologacao
# Usado so pelo container do MySQL (docker-compose.hml.yml), nao pelo
# Django.
MYSQL_ROOT_PASSWORD=TODO-senha-forte-de-root-so-de-homologacao

# TODO: revisar para https:// assim que o Nginx tiver certificado
# (server_name em docker/nginx/homolog.conf) - por enquanto so HTTP.
CSRF_TRUSTED_ORIGINS=http://192.168.90.109:8010

# FEAT-027 (RN-043/RN-044): autenticacao via Active Directory (LDAP) e
# sincronizacao pos-login de e-mail/nome (ADR-002). USE_AD_AUTH=false
# mantem 100% login local (padrao), sem chamada ao AD. NUNCA colocar
# valores reais aqui (CLAUDE.md Sec. 6) - configurar direto no .env.hml
# real, fora do controle de versao.
USE_AD_AUTH=false
AD_SERVER_URI=ldap://TODO-servidor-ad:389
AD_BIND_DN=TODO-conta-de-servico@dominio.local
AD_BIND_PASSWORD=TODO-senha-da-conta-de-servico
AD_USER_SEARCH_BASE=DC=TODO,DC=dominio
AD_DEFAULT_DOMAIN=dominio.local

# Caixa propria do sistema (RF-07/RF-08, FEAT-008/FEAT-009/FEAT-014).
# console.EmailBackend so imprime no log - trocar para smtp assim que a
# caixa de homologacao/producao estiver definida.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.office365.com
EMAIL_PORT=587
EMAIL_HOST_USER=TODO-usuario
EMAIL_HOST_PASSWORD=TODO-senha
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=posvendas@megainfraestrutura.com.br

# FEAT-009 (RF-08/RF-19): polling do financeiro via Microsoft Graph.
# GRAPH_FINANCEIRO_ENABLED=False falha rapido e nao derruba o container
# email_scheduler (ver docker-compose.hml.yml) enquanto o app do Azure
# desta homologacao nao estiver provisionado.
GRAPH_FINANCEIRO_ENABLED=False
GRAPH_FINANCEIRO_CLIENT_ID=TODO-client-id-do-app-dedicado
GRAPH_FINANCEIRO_CLIENT_SECRET=TODO-client-secret-do-app-dedicado
GRAPH_FINANCEIRO_TENANT_ID=TODO-tenant-id
GRAPH_FINANCEIRO_MAILBOX=posvendas@megainfraestrutura.com.br
GRAPH_FINANCEIRO_POLL_INTERVAL_SECONDS=300
