# Gerenciador Pos-Venda - variaveis de ambiente (v1.0.0)
# Nunca versionar um .env com valores reais (CLAUDE.md Sec. 6).

SECRET_KEY=troque-por-uma-chave-secreta-unica
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Banco de dados: MySQL 8.0 em todos os ambientes, inclusive local
# (architecture.md, "Banco de Dados"). "sqlite" so existe como opcao de
# fallback do proprio settings.py, nao e o padrao esperado pelo Docker.
DB_ENGINE=mysql
DB_NAME=gerenciador_posvenda
DB_USER=posvenda_app
DB_PASSWORD=troque-por-uma-senha
DB_HOST=db
DB_PORT=3306
# Usado só pelo container do MySQL (docker-compose.yml), não pelo Django.
MYSQL_ROOT_PASSWORD=troque-por-uma-senha-de-root

CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Caixa propria do sistema (RF-07/RF-08) - preencher no FEAT-008/FEAT-009
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=posvendas@megainfraestrutura.com.br
