# Gerenciador Pos-Venda - variaveis de ambiente (v1.0.0)
# Nunca versionar um .env com valores reais (CLAUDE.md Sec. 6).

SECRET_KEY=troque-por-uma-chave-secreta-unica
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Banco de dados: "sqlite" (padrao local, FEAT-001) ou "mysql"
DB_ENGINE=sqlite
# DB_NAME=gerenciador_posvenda
# DB_USER=posvenda_app
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=3306

CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Caixa propria do sistema (RF-07/RF-08) - preencher no FEAT-008/FEAT-009
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=posvendas@megainfraestrutura.com.br
