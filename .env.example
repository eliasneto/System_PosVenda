# Gerenciador Pos-Venda - variaveis de ambiente (v1.0.0)
# Nunca versionar um .env com valores reais (CLAUDE.md Sec. 6).

SECRET_KEY=troque-por-uma-chave-secreta-unica
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Banco de dados: MySQL 8.0 em todos os ambientes, inclusive local
# (architecture.md, "Banco de Dados"). "sqlite" so existe como opcao de
# fallback do proprio settings.py, nao e o padrao esperado pelo Docker.
DB_ENGINE=mysql
DB_NAME=gerenciador_posvenda
DB_USER=posvenda_app
DB_PASSWORD=troque-por-uma-senha
DB_HOST=db
DB_PORT=3306
# Usado só pelo container do MySQL (docker-compose.yml), não pelo Django.
MYSQL_ROOT_PASSWORD=troque-por-uma-senha-de-root

CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# FEAT-027 (RN-043/RN-044): autenticacao via Active Directory (LDAP) e
# sincronizacao pos-login de e-mail/nome, reaproveitando a mesma conta de
# servico e config ja usadas no .env do modulo-posVenda (ADR-002).
# USE_AD_AUTH=false mantem 100% login local (padrao), sem chamada ao AD.
# NUNCA colocar valores reais aqui (CLAUDE.md Sec. 6) - configurar direto
# no .env real, fora do controle de versao.
USE_AD_AUTH=false
AD_SERVER_URI=ldap://troque-pelo-servidor-ad:389
AD_BIND_DN=troque-pela-conta-de-servico@dominio.local
AD_BIND_PASSWORD=troque-pela-senha-da-conta-de-servico
AD_USER_SEARCH_BASE=DC=troque,DC=pelo,DC=dominio
AD_DEFAULT_DOMAIN=dominio.local

# Caixa propria do sistema (RF-07/RF-08, FEAT-008/FEAT-009/FEAT-014)
# Usar smtp.EmailBackend para envio real; console.EmailBackend so imprime
# no log e nao entrega nada (nao usar em producao nem para testar entrega).
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.office365.com
EMAIL_PORT=587
EMAIL_HOST_USER=troque-por-um-usuario
EMAIL_HOST_PASSWORD=troque-por-uma-senha
EMAIL_USE_TLS=True
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=30
DEFAULT_FROM_EMAIL=posvendas@megainfraestrutura.com.br
SERVER_EMAIL=posvendas@megainfraestrutura.com.br

# FEAT-009 (RF-08/RF-19): leitura da resposta do financeiro, por polling
# (~5 min) via Microsoft Graph (IMAP com usuario/senha nao funciona mais
# nessa caixa - Basic Auth aposentada pela Microsoft). App do Azure AD
# EXCLUSIVO deste sistema (Mail.Read na caixa do financeiro) - nunca
# reaproveitar o app do modulo-posVenda (sistemas independentes).
GRAPH_FINANCEIRO_ENABLED=False
GRAPH_FINANCEIRO_CLIENT_ID=troque-pelo-client-id-do-app-dedicado
GRAPH_FINANCEIRO_CLIENT_SECRET=troque-pelo-client-secret-do-app-dedicado
GRAPH_FINANCEIRO_TENANT_ID=troque-pelo-tenant-id
GRAPH_FINANCEIRO_MAILBOX=posvendas@megainfraestrutura.com.br
GRAPH_FINANCEIRO_TIMEOUT=30
GRAPH_FINANCEIRO_INITIAL_LOOKBACK_DAYS=15
GRAPH_FINANCEIRO_MAX_PAGES_PER_RUN=20
# Cadencia do agendamento (container email_scheduler, docker-compose.yml) -
# nao e lido pelo settings.py, so pelo loop do container. 300s = ~5 min,
# mesmo intervalo ja citado em architecture.md/services.py.
GRAPH_FINANCEIRO_POLL_INTERVAL_SECONDS=300